# Real Foundry Local is the default. The fake adapter is test-only and must be
# selected explicitly with TRACEFOLD_RUNTIME=fake.
TRACEFOLD_RUNTIME=foundry
TRACEFOLD_EMBEDDING_MODEL=qwen3-embedding-0.6b
TRACEFOLD_CHAT_MODEL=qwen2.5-14b
TRACEFOLD_DEVICE=auto
TRACEFOLD_TRANSLATION_RUNTIME=marian
TRACEFOLD_TRANSLATION_BEAMS=4
TRACEFOLD_TRANSLATION_MAX_TOKENS=256
TRACEFOLD_TRANSLATION_ROUNDTRIP_THRESHOLD=0.60

# RAG settings. Re-run the checked-in evaluation after changing these.
TRACEFOLD_RETRIEVAL_THRESHOLD=0.60
TRACEFOLD_EVIDENCE_FLOOR=0.30
TRACEFOLD_MAX_CHUNKS_PER_DOCUMENT=2
TRACEFOLD_CHUNK_SIZE=240
TRACEFOLD_CHUNK_OVERLAP=45
TRACEFOLD_MAX_CONTEXT_CHUNKS=4
TRACEFOLD_MAX_OUTPUT_TOKENS=220
TRACEFOLD_CONTEXT_CHAR_BUDGET=3200
TRACEFOLD_RANDOM_SEED=42

# Keep empty for same-origin production-style demos. Vite proxies `/api` to the
# local backend during frontend development.
VITE_API_URL=
